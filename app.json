{
  "expo": {
    "name": "Jellyboxd",
    "slug": "jellyboxd",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "jellyboxd",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#14181c",
    "ios": {
      "backgroundColor": "#14181c",
      "supportsTablet": true,
      "bundleIdentifier": "com.matthewhalf.jellyboxd",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "com.matthewhalf.jellyboxd",
      "adaptiveIcon": {
        "backgroundColor": "#121212",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121212",
          "image": "./assets/images/icon.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ff5aaf39-4a4f-4c55-9789-d13673163c53"
      }
    },
    "owner": "mattheeww",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ff5aaf39-4a4f-4c55-9789-d13673163c53"
    }
  }
}
